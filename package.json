{
  "name": "ecod-platform",
  "version": "0.1.0",
  "private": true,
  "description": "ECOD - Enterprise Capability on Demand. Config-driven assessment, gap mapping and enterprise-ready talent platform.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "seed": "node scripts/seed.mjs",
    "seed:fresh": "SEED_FRESH=1 node scripts/seed.mjs",
    "airtable:setup": "STORAGE=airtable node scripts/airtable-setup.mjs",
    "seed:airtable": "STORAGE=airtable node scripts/seed.mjs",
    "bank:extract": "node scripts/extract-question-bank-from-xlsx.mjs \"Question bank 1.4.xlsx\" data/bank.json",
    "bank:build": "python3 scripts/build-question-bank.py data/bank.json src/content/rsa-question-bank.mjs 1.4 scripts/rsa-bank-config.json",
    "bank:rebuild": "npm run bank:extract && npm run bank:build",
    "bank:ai-bi-extract": "node scripts/extract-ai-bi-bank-from-xlsx.mjs \"AI BI G Question bank 1.1.xlsx\" data/ai-bi-bank.json",
    "bank:ai-bi-build": "python3 scripts/build-question-bank.py data/ai-bi-bank.json src/content/ai-bi-genie-question-bank.mjs 1.1 scripts/ai-bi-bank-config.json",
    "bank:ai-bi-rebuild": "npm run bank:ai-bi-extract && npm run bank:ai-bi-build",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "python3 tests/smoke.py",
    "test:features": "python3 tests/features.py",
    "test:gauntlet": "python3 tests/final-gauntlet.py"
  },
  "optionalDependencies": {
    "@netlify/blobs": "^10.7.12",
    "jsdom": "^29.1.1"
  }
}
